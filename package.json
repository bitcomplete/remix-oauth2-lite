{
  "name": "remix-oauth2-lite",
  "version": "0.3.15",
  "description": "A lightweight OAuth2 authentication library for Remix",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    },
    "./providers/*": {
      "types": "./build/providers/*.d.ts",
      "import": "./build/providers/*.js",
      "require": "./build/providers/*.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "build/*"
      ]
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitcomplete/remix-oauth2-lite.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bitcomplete/remix-oauth2-lite/issues"
  },
  "homepage": "https://github.com/bitcomplete/remix-oauth2-lite#readme",
  "dependencies": {
    "@remix-run/node": "^2.8.1",
    "@remix-run/server-runtime": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@remix-run/node": "^2.0.0",
    "@remix-run/server-runtime": "^2.0.0"
  }
}
